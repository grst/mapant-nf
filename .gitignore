.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.devcontainer

# Nextflow
work/
work_*/
results*/
.nextflow/
.nextflow.log*
.nextflow.*.log*

# Scratch directories the shell tests build and tear down
.grid_independence/
.failure_injection/
.stub_wiring/

# Test data: ~52 GB of LiDAR, OSM extracts and a prototype karttapullautin run. Not distributable,
# and `git add -A` without this line commits all of it. The subsets derived from it that the test
# profile needs live in assets/ and tests/fixtures/, and those *are* tracked.
testdata/
# Anchored. Unanchored, `test_*` matches at every level, so it silently swallows every new file in
# tests/ -- the existing ones are only visible because they were added before the line was.
/test_*

# karttapullautin writes these into its working directory and never cleans them up, so they should
# only ever appear here if something was run by hand at the repo root.
/pullauta.ini
/temp
/temp[0-9]*
/*.xyz.bin
/pullautus*.png
/pullautus*.pgw
