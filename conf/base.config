/*
 * Default resources and failure handling.
 *
 * The numbers here suit a workstation. conf/c8id.config shows what to change for a big node; the
 * table in README.md explains the disk arithmetic, which is the constraint that actually bites.
 */

process {
    cpus = 1
    memory = 2.GB

    // 'finish' rather than 'terminate': let running tasks complete before stopping. A grid that has
    // already paid for 30 GB of downloads should not be thrown away because a sibling failed.
    errorStrategy = 'finish'

    withLabel: process_single {
        cpus = 1
        memory = 2.GB
    }

    withLabel: process_low {
        cpus = 2
        memory = 4.GB
    }

    // One osmium pass reads the whole source pbf and holds a per-extract id set for
    // --strategy=smart, so memory scales with params.osm_chunk_size rather than with cpus.
    withLabel: process_osm_extract {
        cpus = 2
        memory = { 16.GB * task.attempt }
    }

    withLabel: process_pullauta {
        // Kept in step with params.pullauta_processes, which is what goes into the ini: if the two
        // disagreed, karttapullautin would spawn more workers than the task was scheduled for.
        cpus = { params.pullauta_processes }
        // Measured from the prototype: karttapullautin's shapefile renderer allocates a dozen
        // full-tile canvases per worker, so about 2 GB per worker plus headroom. Growing it per
        // attempt means an OOM kill is retried with more room rather than failing identically.
        memory = { 2.GB * params.pullauta_processes + 2.GB * task.attempt }

        // The scripts exit non-zero only for failures a retry could plausibly fix -- timeouts, 5xx, a
        // full disk, a grid that rendered nothing -- and record per-tile problems as holes without
        // failing, so retrying never masks a broken tile.
        //
        // 'ignore' rather than 'finish' once the retries are spent: one unrenderable grid must not end
        // a run that has already spent days and terabytes on the other ten thousand. The grid is lost
        // and the run stays green, so main.nf's onComplete handler reports the loss loudly instead.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    withLabel: process_tiles {
        cpus = 2
        // k2t merges every source PNG overlapping a parent tile into one array before slicing it:
        // ~1.1 GB at z12 and the source's 0.42 m/px, four times that per zoom level below.
        memory = { params.base_zoom >= 13 ? 4.GB * task.attempt : 8.GB * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries = 2
    }
}
