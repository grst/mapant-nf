/*
 * Production sizing for a single c8id.32xlarge with the local executor.
 * 128 vCPU, 256 GiB RAM, 2 x 1900 GiB NVMe, 50 Gbps, Granite Rapids.
 *
 * Two things to set up outside the pipeline:
 *
 *   1. Put workDir on the instance NVMe -- `-w /mnt/nvme/work`. That is where every grid's laz files
 *      and karttapullautin temporaries live, and it is the only real constraint on concurrency. The
 *      two NVMe devices should be striped (mdadm/LVM RAID-0) and formatted at first boot.
 *   2. Publish somewhere durable. Instance storage is lost when the instance stops. Either point
 *      --outdir at EBS/S3 with publish_mode 'copy', or keep the pyramid on the NVMe with 'link'
 *      during the run and sync it once at the end -- much cheaper for millions of small files.
 *
 * Granite Rapids has AVX-512, so the dispatch wrapper in the karttapullautin image selects the
 * x86-64-v4 build here. That path cannot be exercised on an AVX2-only development machine, so the
 * first line of the log is worth checking: "pullauta: ISA variant v4".
 *
 * Rough budget for all of Bavaria (71,979 tiles). These are estimates built on ~4 CPU-min per tile,
 * which is the one number that should be measured rather than trusted -- run -profile
 * test_immenstadt first and recompute from its trace.txt.
 *
 *   render     71,979 tiles x ~2.5 CPU-min ~= 3,000 CPU-h  -> ~26 h at ~90% utilisation
 *   tiling     ~1,600 z12 parents         ~=    50 CPU-h  -> ~1 h
 *   peak disk  7 concurrent grids x ~117 GB ~= 820 GB, plus ~90 GB of retained PNGs
 *              and ~350 GB of published pyramid: ~1.3 TB of 3.8 TB
 *
 * The render figure comes from four measured grids across two regions (see README.md). The download
 * is the part that is NOT known: 19 TB has to arrive, and measured from a development machine
 * geodaten.bayern.de delivered only ~30 MB/s in total -- a cap on the aggregate, not per stream, so
 * more parallelism did not help. At that rate the download alone is over seven days and dwarfs the
 * compute. That may well have been the development machine's uplink rather than the server, so
 * BENCHMARK FROM THIS NODE before planning:
 *
 *   curl -s -o /dev/null -w '%{speed_download} B/s\n' \
 *       https://geodaten.bayern.de/odd_data/laser/590_5269.laz
 *
 * Below ~200 MB/s sustained the run is download-bound and worth restructuring (ask the provider
 * about a bulk transfer or a mirror). Above it, expect roughly a day and a half end to end.
 *
 *   nextflow run . -profile podman,c8id -w /mnt/nvme/work --tiles_csv ... --osm_pbf ...
 */

process {
    executor = 'local'
}

executor {
    // The local executor otherwise assumes it may use every core, which oversubscribes the box once
    // several 16-thread renders overlap. Leaving a little headroom keeps the scheduler responsive.
    cpus = 124
    memory = 240.GB
}

params {
    // 16 rather than the default 10: halo re-fetching drops from 1.44x to 1.27x, which is ~2.5 TB
    // less traffic over a full Bavaria run. The cost is ~117 GB of disk per concurrent grid, which
    // this node has.
    grid_size = 16
    pullauta_processes = 16

    base_zoom = 12
    max_zoom = 18

    // Eight streams from one host, rate-capped. The bottleneck is the open-data server, not this
    // machine, and a 19 TB pull deserves a conversation with the data provider before it starts.
    download_jobs = 8
    download_limit_rate = '200M'

    osm_chunk_size = 32
    publish_mode = 'link'
}

process {
    withLabel: process_pullauta {
        // 7 x 16 threads = 112 vCPU, and 7 x ~117 GB = ~820 GB of NVMe. Disk is the binding
        // constraint here, not CPU: raise this only after checking `df` on the work volume.
        maxForks = 7
        memory = { 34.GB * task.attempt }
    }

    withLabel: process_tiles {
        maxForks = 16
        memory = { 8.GB * task.attempt }
    }

    withLabel: process_osm_extract {
        cpus = 4
        memory = 16.GB
    }
}
