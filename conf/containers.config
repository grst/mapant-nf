/*
 * Container images, one place.
 *
 * Kept out of the modules so images can be repointed at a registry, or pinned to a digest, without
 * editing pipeline code. Build them locally with `containers/build.sh`, or override these to pull
 * from wherever you pushed them:
 *
 *   nextflow run . --container_karttapullautin ghcr.io/you/karttapullautin:2.13.0
 */

params {
    container_karttapullautin = 'mapant/karttapullautin:2.13.0'
    container_gdal = 'mapant/gdal:latest'
    container_osmium = 'mapant/osmium:latest'
    // Also the generic Python image: k2t's own dependencies (geopandas, shapely, pyproj,
    // mercantile, rasterio, pillow) are exactly what bin/*.py needs.
    container_k2t = 'mapant/k2t:latest'
}
