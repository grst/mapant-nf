/*
 * Container images, one place. The defaults are what .github/workflows/containers.yml publishes to
 * GHCR from main, so a fresh clone runs without building anything.
 *
 * To point the pipeline elsewhere -- at images from containers/build.sh, or at a mirror -- override
 * the selector in a config of your own:
 *
 *   process { withName: MAKE_VECTOR_TILES { container = 'ghcr.io/you/tiler:1' } }
 *
 * On reproducibility: `latest` moves when a Containerfile changes; the karttapullautin tag names the
 * commit it is built from. Every published image also carries an immutable `ctx-<hash>` tag -- the
 * git tree hash of its build context, which is what the workflow uses to decide whether a rebuild is
 * needed at all. Pin those for a run whose exact toolchain has to be reconstructible later; `ghcr.io/grst/mapant-nf/<name>` lists them.
 */

process {
    // tippecanoe, and the Python that everything in bin/ needs. One image for the planning, the
    // tiling and the viewer because their dependency sets are the same one.
    withName: 'PLAN_GRIDS|RENDER_INI|MAKE_VECTOR_TILES|MERGE_PMTILES|MAKE_VIEWER' {
        container = 'ghcr.io/grst/mapant-nf/tiler:latest'
    }
    withName: PULLAUTA_GRID {
        container = 'ghcr.io/grst/mapant-nf/karttapullautin:c2a060f'
    }
    withName: OSM_EXTRACT {
        container = 'ghcr.io/grst/mapant-nf/osmium:latest'
    }
    withName: OSM_TO_SHAPES {
        container = 'ghcr.io/grst/mapant-nf/gdal:latest'
    }
}
