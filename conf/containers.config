/*
 * Container images, one place.
 *
 * Kept out of the modules so images can be repointed at a registry, or pinned to a digest, without
 * editing pipeline code.
 *
 * The defaults are the images .github/workflows/containers.yml publishes to GHCR from main, so a
 * fresh clone runs without building anything. Two other ways to point the pipeline elsewhere:
 *
 *   nextflow run . -profile podman,local_images        # after containers/build.sh
 *   nextflow run . --container_k2t ghcr.io/you/k2t:1   # one image, anywhere
 *
 * On reproducibility: `latest` and `2.13.0` move when a Containerfile changes. Every published image
 * also carries an immutable `ctx-<hash>` tag -- the git tree hash of its build context, which is what
 * the workflow uses to decide whether a rebuild is needed at all. Pin those tags for a run whose
 * exact toolchain has to be reconstructible later; `ghcr.io/grst/mapant-nf/<name>` lists them.
 */

params {
    container_karttapullautin = 'ghcr.io/grst/mapant-nf/karttapullautin:2.13.0'
    container_gdal = 'ghcr.io/grst/mapant-nf/gdal:latest'
    container_osmium = 'ghcr.io/grst/mapant-nf/osmium:latest'
    // Also the generic Python image: k2t's own dependencies (geopandas, shapely, pyproj,
    // mercantile, rasterio, pillow) are exactly what bin/*.py needs.
    container_k2t = 'ghcr.io/grst/mapant-nf/k2t:latest'
}
