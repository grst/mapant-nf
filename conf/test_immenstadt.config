/*
 * The real thing in miniature: a small region around Immenstadt im Allgaeu, downloaded from the
 * source server, rendered, tiled and cleaned up as a full run would be.
 *
 * Validates what test_local cannot: the download path and the server actually being reachable. It is
 * also what the runtime estimate in README.md should be calibrated from. After a run:
 *
 *   awk -F'\t' '$3 == "COMPLETED" && $2 ~ /PULLAUTA_GRID/' results_immenstadt/pipeline_info/trace.txt
 *
 * gives realtime x cpus per grid; divide by the grid's core-tile count for the per-tile CPU cost,
 * then multiply by the tile count of the region you actually want.
 *
 * Cost: 24 distinct laz files, ~5.4 GiB fetched (1.33x amplification), never more than ~2.7 GiB
 * resident at once because each grid deletes its inputs before it finishes.
 *
 *   nextflow run . -profile podman,test_immenstadt
 */

params {
    tiles_csv = "${projectDir}/testdata/laz_tiles.csv"
    osm_pbf = "${projectDir}/testdata/shapefiles_bayern/bayern-260728.osm.pbf"

    // Easting 590-593 km x northing 5268-5269 km: the Immenstadt basin and the Grosser Alpsee.
    // Lattice-aligned at grid_size 2, so it becomes exactly two 2x2 grids, and parent 13/4328/2862
    // draws its imagery from both -- the property the groupKey join has to get right.
    region_bbox = '590000,5268000,594000,5270000'
    region_bbox_crs = 'EPSG:25832'

    grid_size = 2
    pullauta_processes = 2

    base_zoom = 13
    max_zoom = 16

    // Deliberately gentle on a public open-data server. geodaten.bayern.de is a single CERN httpd;
    // four parallel streams from one host is polite, and the rate cap keeps a test run from
    // saturating whatever link it happens to be on.
    download_jobs = 4
    download_limit_rate = '20M'

    map_title = 'mapant test -- Immenstadt im Allgaeu'
    outdir = 'results_immenstadt'
    publish_mode = 'copy'
}

process {
    withLabel: process_pullauta {
        maxForks = 1
    }
    withLabel: process_tiles {
        maxForks = 2
        memory = 3.GB
    }
    withLabel: process_osm_extract {
        memory = 4.GB
    }
}
