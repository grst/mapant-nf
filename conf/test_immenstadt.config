/*
 * The real thing in miniature: a small region around Immenstadt im Allgaeu, downloaded from the
 * source server, rendered, tiled and cleaned up as a full run would be.
 *
 * Self-contained -- both inputs are committed, so this runs on any machine with a container engine
 * and a network connection, and it is the only end-to-end test that does:
 *
 *   assets/laz_tiles_immenstadt.csv   the 24 rows of Bavaria's tile export that this region needs
 *   assets/immenstadt.osm.pbf         an osmium extract of bayern-latest, 2.5 MB rather than 809 MB
 *
 * Both are subsets rather than substitutes. The CSV is the region's 8 core tiles plus their full
 * one-ring halo (easting 589-594 km x northing 5267-5270 km), and PLAN_GRIDS draws its halo from the
 * whole CSV, so the grids it plans here are the ones a full-Bavaria run plans for the same bbox. The
 * pbf covers every grid's bbox plus the 2 km osm_buffer_m with room to spare, and OSM_EXTRACT cuts
 * byte-identical per-grid extracts from it and from the full 809 MB file -- verified with `cmp`, not
 * assumed. How the pbf was cut, should the region or the source extract ever change:
 *
 *   osmium extract --bbox 10.13,47.515,10.315,47.62 --strategy smart --set-bounds \
 *       -o assets/immenstadt.osm.pbf bayern-260728.osm.pbf
 *
 * The bbox is the union of the two grids' osmium chunk bboxes (see the plan_summary of a run) with
 * ~2 km of slack; --strategy smart is what OSM_EXTRACT uses, so ways and relations crossing the cut
 * are kept whole here too and the second cut has everything it needs.
 *
 * This is also what the runtime estimate in README.md should be calibrated from. After a run:
 *
 *   awk -F'\t' '$3 == "COMPLETED" && $2 ~ /PULLAUTA_GRID/' results_immenstadt/pipeline_info/trace.txt
 *
 * gives realtime x cpus per grid; divide by the grid's core-tile count for the per-tile CPU cost,
 * then multiply by the tile count of the region you actually want.
 *
 * Cost: 24 distinct laz files, ~5.4 GiB fetched (1.33x amplification), never more than ~2.7 GiB
 * resident at once because each grid deletes its inputs before it finishes.
 *
 *   nextflow run . -profile podman,test_immenstadt
 */

params {
    tiles_csv = "${projectDir}/assets/laz_tiles_immenstadt.csv"
    osm_pbf = "${projectDir}/assets/immenstadt.osm.pbf"

    // Easting 590-593 km x northing 5268-5269 km: the Immenstadt basin and the Grosser Alpsee. The
    // CSV also holds the ring of tiles around this box; they are halo, never rendered.
    //
    // Lattice-aligned at grid_size 2, so it becomes exactly two 2x2 grids, and parent 13/4328/2862
    // draws its imagery from both -- the property the groupKey join has to get right.
    region_bbox = '590000,5268000,594000,5270000'
    region_bbox_crs = 'EPSG:25832'

    grid_size = 2
    pullauta_processes = 2

    base_zoom = 13
    max_zoom = 16

    // Deliberately gentle on a public open-data server. geodaten.bayern.de is a single CERN httpd;
    // four parallel streams from one host is polite, and the rate cap keeps a test run from
    // saturating whatever link it happens to be on.
    download_jobs = 4
    download_limit_rate = '20M'

    map_title = 'mapant test -- Immenstadt im Allgaeu'
    outdir = 'results_immenstadt'
    publish_mode = 'copy'
}

process {
    withLabel: process_pullauta {
        maxForks = 1
    }
    withLabel: process_tiles {
        maxForks = 2
        memory = 3.GB
    }
    withLabel: process_osm_extract {
        memory = 4.GB
    }
}
