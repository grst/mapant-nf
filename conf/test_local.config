/*
 * Fast end-to-end test with no network traffic at all.
 *
 * Renders from the laz files already in testdata/kemptner_wald/in/, reached through
 * params.laz_local_dir -- an ordinary staged input, so this works on any executor and needs no bind
 * mount. They are still size- and sha256-checked, so the verification path is exercised rather than
 * bypassed.
 *
 * The tiles CSV is a 23-row fixture rather than the full Bavaria list on purpose: the halo pool is
 * drawn from the whole CSV, so pointing this at the full list would fetch the neighbours of the local
 * block from the internet (~10 GB). Restricting the CSV makes those 23 tiles *be* the dataset, so its
 * edge tiles legitimately have no neighbours.
 *
 *   nextflow run . -profile podman,test_local
 */

params {
    tiles_csv = "${projectDir}/tests/fixtures/laz_tiles_kemptner_wald.csv"
    laz_local_dir = "${projectDir}/testdata/kemptner_wald/in"
    osm_pbf = "${projectDir}/testdata/shapefiles_bayern/bayern-260728.osm.pbf"

    // Easting 606-609 km x northing 5284-5285 km. Chosen to be lattice-aligned at grid_size 2, so it
    // splits into exactly two 2x2 grids -- and so at least one web-mercator parent draws tiles from
    // both of them, which is the cross-grid join this test exists to exercise.
    region_bbox = '606000,5284000,610000,5286000'
    region_bbox_crs = 'EPSG:25832'

    grid_size = 2
    pullauta_processes = 2

    // z13 rather than the z12 default: k2t holds every source PNG overlapping a parent in memory at
    // once, and a z12 parent needs ~1.1 GB where a z13 parent needs a quarter of that. This machine
    // has ~7 GB free.
    base_zoom = 13
    max_zoom = 16

    map_title = 'mapant test -- Kemptner Wald'
    outdir = 'results_test_local'
    publish_mode = 'copy'
}

process {
    withLabel: process_pullauta {
        maxForks = 1
    }
    withLabel: process_tiles {
        maxForks = 2
        memory = 3.GB
    }
    withLabel: process_osm_extract {
        memory = 4.GB
    }
}
