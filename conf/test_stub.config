/*
 * Wiring test: the whole DAG, no data, no containers, about a minute.
 *
 * Intended for `-stub-run` and for CI, where neither the 52 GB of testdata/ nor a container runtime
 * is available. Every process that needs real inputs to do anything (rendering, osmium, ogr2ogr,
 * k2t) has a `stub:` block that fabricates correctly *named* outputs; PLAN_GRIDS, RENDER_INI and
 * TILE_VIEWER have none, so they run for real -- they are pure Python and the interesting part of a
 * stub run is precisely that the plan they produce lines up with the names everything downstream
 * joins on.
 *
 * What this catches that a unit test cannot: channel joins keyed on tile or grid ids, groupKey's
 * per-parent counts, the `remainder: true` on both the shapes join and groupTuple, publishing a
 * nested z/x/y tree from many tasks, and the output block. Those are where this pipeline's real bugs
 * have been.
 *
 * What it does not check: anything about pixels. A stub run is green on a pipeline that renders
 * garbage. tests/test_grid_independence.sh and `-profile test_local` are what cover that, and both
 * need the LiDAR.
 *
 *   nextflow run . -stub-run -profile test_stub
 */

params {
    tiles_csv = "${projectDir}/tests/fixtures/laz_tiles_kemptner_wald.csv"

    // An empty placeholder, valid only under -stub-run: OSM_EXTRACT's stub reads the chunk config
    // for its output names and never opens this file. It is set at all because the alternative --
    // leaving osm_pbf null -- skips the OSM branch entirely, and that branch is two of the joins
    // worth testing.
    osm_pbf = "${projectDir}/tests/fixtures/stub.osm.pbf"

    // The same region as test_local: lattice-aligned at grid_size 2, so it splits into exactly two
    // grids and at least one z13 parent draws tiles from both of them. That cross-grid parent is the
    // fan-in this test exists to exercise.
    region_bbox = '606000,5284000,610000,5286000'
    region_bbox_crs = 'EPSG:25832'

    grid_size = 2
    pullauta_processes = 2

    base_zoom = 13
    max_zoom = 16
    min_zoom = 9

    map_title = 'mapant stub run'
    outdir = 'results_test_stub'
    publish_mode = 'copy'
}
