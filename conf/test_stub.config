/*
 * Wiring test: the whole DAG, no data, no containers, about a minute. For `-stub-run` and for CI,
 * where neither the 52 GB of testdata/ nor a container runtime is available.
 *
 * Every process that needs real inputs has a `stub:` block fabricating correctly *named* outputs.
 * PLAN_GRIDS, RENDER_INI and TILE_VIEWER have none and run for real: they are pure Python, and the
 * interesting part of a stub run is that their plan lines up with the names everything downstream
 * joins on.
 *
 * What this catches that a unit test cannot: channel joins keyed on tile or grid ids, groupKey's
 * per-parent counts, the `remainder: true` on both the shapes join and groupTuple, publishing a nested
 * z/x/y tree from many tasks, and the output block.
 *
 * What it does not check: pixels. A stub run is green on a pipeline that renders garbage;
 * `-profile test_immenstadt` covers that, and it needs the real LiDAR.
 *
 *   nextflow run . -stub-run -profile test_stub
 */

params {
    tiles_csv = "${projectDir}/tests/fixtures/laz_tiles_kemptner_wald.csv"

    // An empty placeholder, valid only under -stub-run: OSM_EXTRACT's stub reads the chunk config
    // for its output names and never opens this file. It is set at all because the alternative --
    // leaving osm_pbf null -- skips the OSM branch entirely, and that branch is two of the joins
    // worth testing.
    osm_pbf = "${projectDir}/tests/fixtures/stub.osm.pbf"

    // Lattice-aligned at grid_size 2, so it splits into exactly two grids and at least one z13
    // parent draws tiles from both of them. That cross-grid parent is the fan-in this test exists to
    // exercise. A tracked fixture rather than the live CSV: nothing here is downloaded, so the rows
    // only have to be geometrically real.
    region_bbox = '606000,5284000,610000,5286000'
    region_bbox_crs = 'EPSG:25832'

    grid_size = 2
    pullauta_processes = 2

    base_zoom = 13
    max_zoom = 16

    map_title = 'mapant stub run'
    outdir = 'results_test_stub'
    publish_mode = 'copy'
}

process {
    // A stub task fabricates empty files and allocates nothing, but the local executor still refuses
    // to submit one whose `memory` exceeds the machine's -- and a GitHub runner has 15.6 GB against
    // the 16 GB conf/base.config asks for an osmium pass. That is a CI failure caused purely by
    // production sizing, in the one test that is supposed to be about wiring.
    //
    // resourceLimits rather than repeating each directive: it caps whatever the labels resolve to,
    // so base.config stays free to describe the hardware a real run wants without this test having
    // to track it.
    resourceLimits = [cpus: 2, memory: 2.GB]
}
