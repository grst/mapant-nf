# karttapullautin, built three times for three instruction-set levels.
#
# Why build from source at all: the vector output this pipeline reads (per-tile GeoJSON in WGS84)
# is not in an upstream release yet. It is built from the fork's branch behind
# grst/karttapullautin#3, pinned to a commit. Once that work is released upstream, point
# PULLAUTA_REPO back at karttapullautin/karttapullautin and PULLAUTA_REF at the release tag.
#
# Building from source is also what gets an AVX-512 build at all: the release assets have no such
# variant, and prompt.md requires that a machine which supports AVX-512 gets one, so the binaries
# are compiled here with an explicit -C target-cpu.
#
# Why `--target x86_64-unknown-linux-gnu` on every cargo invocation, and not just RUSTFLAGS:
# without --target, cargo applies RUSTFLAGS to *host* artifacts too -- build scripts and proc
# macros (serde_derive, bytemuck_derive, and the -sys crates behind zip/laz all have them). The
# x86-64-v4 pass would then compile a build script with AVX-512 and immediately execute it on the
# build machine, which dies with SIGILL on anything older than Ice Lake. Naming the target makes
# cargo treat this as a cross-compile, so RUSTFLAGS reaches only the target artifacts and build
# scripts stay baseline. That is what lets an AVX2-only laptop build the AVX-512 binary at all.
#
# Runtime deps look unrelated to rendering, and are not: download, checksum verification, rendering
# and cleanup all happen inside a *single* process, so curl and the Python that drives bin/*.py have
# to live in this image alongside pullauta.
FROM docker.io/library/rust:1.97-bookworm AS build

ARG PULLAUTA_REPO=https://github.com/grst/karttapullautin
# A commit rather than a branch, so the same build context always builds the same renderer. It
# is also the image's tag (see containers/build.sh), so bumping it publishes a new image.
ARG PULLAUTA_REF=c2a060fc4497eac3c5cd3c728b2039e392b266d7
ARG CARGO_TARGET=x86_64-unknown-linux-gnu

WORKDIR /src
# fetch rather than `clone --branch`, which takes a branch or a tag but not a commit.
RUN git init -q . \
 && git fetch --depth 1 "${PULLAUTA_REPO}" "${PULLAUTA_REF}" \
 && git checkout -q FETCH_HEAD \
 && git rev-parse HEAD > /src/GIT_SHA \
 # rust-toolchain.toml pins channel "1.97" plus rustfmt/clippy. The image already *is* 1.97, but
 # rustup would try to resolve and download that channel name as a separate toolchain. Nothing in
 # a release build needs it.
 && rm -f rust-toolchain.toml

# A separate CARGO_TARGET_DIR per ISA: sharing one would make cargo rebuild the whole graph each
# pass anyway (RUSTFLAGS is part of the fingerprint), and keeping them apart makes the COPY below
# unambiguous. All of it is discarded with this stage.
RUN set -eux; \
    for isa in x86-64 x86-64-v3 x86-64-v4; do \
        echo "=== building for target-cpu=${isa} ==="; \
        RUSTFLAGS="-C target-cpu=${isa}" \
        CARGO_TARGET_DIR="/build/${isa}" \
        cargo build --release --locked --target "${CARGO_TARGET}"; \
    done


FROM docker.io/library/debian:stable-slim

# apt normally drops privileges to the _apt user (UID 42) to download packages. In the
# devcontainer this pipeline is developed in, container UID 0 is the only UID that exists, so
# that setgroups/seteuid pair fails and the download method dies. APT::Sandbox::User=root keeps
# apt as root instead, which is safe here: the build already runs unprivileged inside a user
# namespace, so apt's own sandbox is defence in depth we cannot use rather than a boundary being
# removed. See containers/build.sh for the full story.
#
# procps is not optional: Nextflow shells out to `ps` to collect task metrics and fails the task
# with "Command 'ps' required by nextflow to collect task metrics cannot be found" without it.
# python3 runs bin/fetch_laz.py and bin/run_pullauta.py; both are standard library only, so there is
# nothing to pin here.
RUN apt-get -o APT::Sandbox::User=root update \
 && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
      ca-certificates \
      curl \
      procps \
      python3 \
 && rm -rf /var/lib/apt/lists/*

ARG CARGO_TARGET=x86_64-unknown-linux-gnu
COPY --from=build /build/x86-64/${CARGO_TARGET}/release/pullauta    /opt/karttapullautin/pullauta-baseline
COPY --from=build /build/x86-64-v3/${CARGO_TARGET}/release/pullauta /opt/karttapullautin/pullauta-v3
COPY --from=build /build/x86-64-v4/${CARGO_TARGET}/release/pullauta /opt/karttapullautin/pullauta-v4
COPY --from=build /src/GIT_SHA                                     /opt/karttapullautin/GIT_SHA
COPY --from=build /src/osm.txt                                     /opt/karttapullautin/osm.txt.example
COPY --from=build /src/pullauta.default.ini                        /opt/karttapullautin/pullauta.default.ini
COPY pullauta /usr/local/bin/pullauta
RUN chmod 0755 /usr/local/bin/pullauta /opt/karttapullautin/pullauta-*

# Without a backtrace, a panic report to the karttapullautin devs is barely actionable, and
# collecting those reports is an explicit requirement.
ENV RUST_BACKTRACE=1

CMD ["/bin/bash"]
