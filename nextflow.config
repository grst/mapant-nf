/*
 * mapant pipeline configuration.
 *
 * Nothing here refers to a host path, a bind mount or a shared filesystem: those are properties of a
 * particular machine (in this devcontainer, ~/.config/containers/*.conf, written by
 * scripts/setup-container-runtime.sh), and keeping them out is what lets the same pipeline run on a
 * laptop, on one big cloud node, or on an HPC scheduler.
 */

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    // `nextflow run . --help` lists every parameter with the documentation from
    // nextflow_schema.json; `--help <param>` explains one.
    help {
        enabled = true
        command = 'nextflow run . -profile podman --tiles_csv tiles.csv --osm_pbf region.osm.pbf'
    }
    // The tiles CSV carries source-specific extra columns (Bavaria's export has a `units` column
    // holding the Regierungsbezirk). They are ignored by design, so the warning naming them is noise.
    ignoreParams = ['units']
}

manifest {
    name = 'mapant'
    description = 'Automatically generated orienteering maps from LiDAR tiles, as web-mercator PNG tiles'
    author = 'Gregor Sturm'
    homePage = 'https://github.com/grst/mapant'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version = '0.1.0'
}

params {
    // ---- inputs -----------------------------------------------------------
    tiles_csv = null                                       // required; see assets/schema_tiles.json
    osm_pbf = null                                         // optional; without it, no vectors
    pullauta_ini = "${projectDir}/assets/pullauta.ini"
    vectorconf = "${projectDir}/assets/osm.txt"
    // A directory of already-downloaded laz files, staged as an ordinary input so it works on every
    // executor. Files found there are used instead of being fetched, but are checksummed the same
    // way. For tests and for re-running against a local mirror.
    laz_local_dir = null

    // ---- region filter ----------------------------------------------------
    region_bbox = null                                     // 'minx,miny,maxx,maxy'
    region_bbox_crs = 'lonlat'                             // 'lonlat' or an EPSG string

    // ---- grids ------------------------------------------------------------
    // Bigger grids re-fetch proportionally fewer halo tiles (1.44x at 10, 1.27x at 16) but need
    // proportionally more disk per task. See the table in README.md.
    grid_size = 10
    pullauta_processes = 8
    max_pullauta_attempts = 6
    png_variant = 'depr'

    // ---- download ---------------------------------------------------------
    download_jobs = 4
    download_retries = 3
    download_limit_rate = null                             // e.g. '20M'; be kind to open-data servers

    // ---- OSM --------------------------------------------------------------
    osm_chunk_size = 32                                    // grids per osmium pass
    osm_buffer_m = 2000
    osm_strategy = 'smart'

    // ---- tiles ------------------------------------------------------------
    // The pyramid spans base_zoom..max_zoom. base_zoom is also the tiling unit, so it bounds
    // MAKE_TILES memory; below it the viewer shows OSM's own tiles.
    base_zoom = 11
    max_zoom = 18                                          // 18 matches the 0.42 m/px source
    map_title = 'mapant'

    // ---- output -----------------------------------------------------------
    outdir = 'results'
    // 'copy' works everywhere, including object stores. Use 'link' when outdir and workDir share a
    // filesystem: far cheaper for millions of small tiles. Never 'move' -- it breaks -resume.
    publish_mode = 'copy'
}

includeConfig 'conf/containers.config'
includeConfig 'conf/base.config'

profiles {
    podman {
        podman.enabled = true
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    // Images built by containers/build.sh on this machine instead of the published ones. Combine with
    // a container engine profile, as in `-profile podman,local_images,test_local`.
    //
    // :latest for all four, including karttapullautin -- build.sh tags every image `latest` as well
    // as its version, so the upstream release number does not have to be repeated here.
    local_images {
        process {
            withName: 'PLAN_GRIDS|RENDER_INI|MAKE_TILES|TILE_VIEWER' {
                container = 'mapant/k2t:latest'
            }
            withName: PULLAUTA_GRID { container = 'mapant/karttapullautin:latest' }
            withName: OSM_EXTRACT { container = 'mapant/osmium:latest' }
            withName: OSM_TO_SHAPES { container = 'mapant/gdal:latest' }
        }
    }

    // The whole DAG with fabricated outputs: no data, no containers, no network. For -stub-run.
    test_stub { includeConfig 'conf/test_stub.config' }

    // Small, fast, no network: renders from the laz files already in testdata/.
    test_local { includeConfig 'conf/test_local.config' }

    // The real thing in miniature: downloads from the source server.
    test_immenstadt { includeConfig 'conf/test_immenstadt.config' }

    // Production sizing for a single large node.
    c8id { includeConfig 'conf/c8id.config' }
}

/*
 * Everything below is derived from params.outdir and must stay BELOW the `profiles` block: a config
 * statement is evaluated where it appears, and a profile's params have not been merged yet at the
 * point the profile is declared. Written above, `outputDir = params.outdir` silently captures the
 * default and publishes there, ignoring both `-profile ...,test_local` and `--outdir`.
 *
 * The output block publishes to `outputDir` rather than to params.outdir; bridging them here keeps
 * `--outdir` working and visible in the params summary.
 */
outputDir = params.outdir

// Where the time went -- downloading, rendering or tiling -- is the first question about any run, and
// the per-task trace is what turns a test run into a credible estimate for a full one.
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields = 'task_id,hash,name,tag,status,exit,attempt,realtime,duration,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

