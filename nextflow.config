/*
 * mapant pipeline configuration.
 *
 * Note what is deliberately absent: nothing here refers to a host path, a bind mount, or a shared
 * filesystem. Those are properties of a particular machine -- in this devcontainer they live in
 * ~/.config/containers/*.conf, written by scripts/setup-container-runtime.sh -- and keeping them
 * out means the same pipeline runs on a laptop, on a single big cloud node, or on an HPC scheduler.
 */

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    // `nextflow run . --help` then lists every parameter with the documentation from
    // nextflow_schema.json, and `--help <param>` explains one. Off by default in nf-schema, and
    // worth turning on: this pipeline has enough knobs that the alternative is reading the config.
    help {
        enabled = true
        command = 'nextflow run . -profile podman --tiles_csv tiles.csv --osm_pbf region.osm.pbf'
    }
    // The tiles CSV is expected to carry source-specific extra columns (Bavaria's export has a
    // `units` column holding the Regierungsbezirk). They are ignored by design, so the per-run
    // warning naming them is noise rather than information.
    ignoreParams = ['units']
}

manifest {
    name = 'mapant'
    description = 'Automatically generated orienteering maps from LiDAR tiles, as web-mercator PNG tiles'
    author = 'Gregor Sturm'
    homePage = 'https://github.com/grst/mapant'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version = '0.1.0'
}

params {
    // ---- inputs -----------------------------------------------------------
    tiles_csv = null                                       // required; see assets/schema_tiles.json
    osm_pbf = null                                         // optional; without it, no vectors
    pullauta_ini = "${projectDir}/assets/pullauta.ini"
    vectorconf = "${projectDir}/assets/osm.txt"
    // A directory of already-downloaded laz files, staged as an ordinary input (so it works on
    // every executor). Files found there are used instead of being fetched -- but are checksummed
    // exactly the same way. Intended for tests and for re-running against a local mirror.
    laz_local_dir = null

    // ---- region filter ----------------------------------------------------
    region_bbox = null                                     // 'minx,miny,maxx,maxy'
    region_bbox_crs = 'lonlat'                             // 'lonlat' or an EPSG string
    region_tile_regex = null
    min_laz_bytes = 0                                      // 0 disables

    // ---- grids ------------------------------------------------------------
    // grid_size is purely a download/IO trade-off, NOT a quality setting: karttapullautin renders
    // each tile from its neighbours within pullauta_halo_m, so a tile's output is identical whatever
    // grid it was batched into. Bigger grids re-fetch proportionally fewer halo tiles (1.44x at 10,
    // 1.27x at 16) but need proportionally more disk per task. See README.md for the table.
    grid_size = 10
    pullauta_halo_m = 127                                  // hard-coded in karttapullautin v2
    pullauta_processes = 8
    max_pullauta_attempts = 6
    png_variant = 'depr'
    // false by default: `scratch true` does work under podman, but it puts the task's working
    // directory on the container's own filesystem, which is the wrong place for tens of gigabytes.
    // PULLAUTA_GRID cleans up after itself either way, so the work dir keeps only the PNGs.
    scratch = false

    // ---- download ---------------------------------------------------------
    download_jobs = 4
    download_retries = 3
    download_limit_rate = null                             // e.g. '20M'; be kind to open-data servers

    // ---- OSM --------------------------------------------------------------
    osm_chunk_size = 32                                    // grids per osmium pass
    osm_buffer_m = 2000
    osm_strategy = 'smart'

    // ---- tiles ------------------------------------------------------------
    base_zoom = 12                                         // bounds MAKE_TILES memory
    max_zoom = 18                                          // 18 matches the 0.42 m/px source
    min_zoom = 8                                           // overviews below base_zoom
    map_title = 'mapant'

    // ---- output -----------------------------------------------------------
    outdir = 'results'
    // 'copy' is the only mode that works everywhere, including object stores. Use 'link' when
    // outdir and workDir share a filesystem: it is far cheaper for millions of small tiles.
    // Never 'move' -- it breaks -resume.
    publish_mode = 'copy'

    // ---- validation -------------------------------------------------------
    validate_tiles = true
    validate_tiles_in_python = false
}

includeConfig 'conf/containers.config'
includeConfig 'conf/base.config'

profiles {
    podman {
        podman.enabled = true
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    // Images built by containers/build.sh on this machine instead of the published ones. Combine
    // with a container engine profile, as in `-profile podman,local_images,test_local`.
    local_images {
        // :latest for all four, including karttapullautin -- build.sh tags every image it builds
        // `latest` as well as its version, precisely so that the upstream release number does not
        // have to be repeated here.
        params.container_karttapullautin = 'mapant/karttapullautin:latest'
        params.container_gdal = 'mapant/gdal:latest'
        params.container_osmium = 'mapant/osmium:latest'
        params.container_k2t = 'mapant/k2t:latest'
    }

    // The whole DAG with fabricated outputs: no data, no containers, no network. For -stub-run.
    test_stub { includeConfig 'conf/test_stub.config' }

    // Small, fast, no network: renders from the laz files already in testdata/.
    test_local { includeConfig 'conf/test_local.config' }

    // The real thing in miniature: downloads from the source server.
    test_immenstadt { includeConfig 'conf/test_immenstadt.config' }

    // Production sizing for a single large node.
    c8id { includeConfig 'conf/c8id.config' }
}

/*
 * Everything below is derived from params.outdir, and must stay BELOW the `profiles` block.
 *
 * A config statement is evaluated where it appears, and a profile's `params` block has not been
 * merged yet at the point the profile is declared -- so `outputDir = params.outdir` written above
 * would silently capture the default and publish there, ignoring both `-profile ...,test_local` and
 * `--outdir`. Down here it sees the merged value. (Found the hard way: the tile pyramid went to
 * results/ while the trace report, which was already below the profiles, went to
 * results_test_local/.)
 *
 * The output block publishes to `outputDir` rather than to params.outdir, so the two are bridged
 * here: `--outdir` keeps working and stays visible in the params summary.
 */
outputDir = params.outdir

// Where the time went -- downloading, rendering or tiling -- is the first question about any run of
// this pipeline, and the per-task trace is what turns a test run into a credible estimate for a full
// one (see README.md).
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields = 'task_id,hash,name,tag,status,exit,attempt,realtime,duration,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

