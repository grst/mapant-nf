/*
 * Bodenmais / Grosser Arber, on the Bavarian-Czech border, sized for this laptop.
 *
 * Not a profile in nextflow.config: it is a one-off region, so it is passed with `-c` instead of
 * being added to the committed profile list. See README.md in this directory for the command and the
 * numbers behind the settings below.
 *
 * What this region exercises that test_local and test_immenstadt cannot: the *edge of the dataset*.
 * The tiles CSV stops at the national border, so the selection is ragged rather than rectangular --
 * 15 grids holding 2 to 25 core tiles instead of 25 each -- and along the border the halo ring is
 * genuinely absent, so those tiles render from fewer points. Nothing special-cases either case; they
 * are the same conditions a full Bavaria run meets at its own perimeter, on 189 tiles instead of
 * 72,000. The OSM extract bboxes cross the border too, where bayern.osm.pbf has nothing to give.
 */

params {
    tiles_csv = "${projectDir}/testdata/laz_tiles.csv"
    osm_pbf = "${projectDir}/testdata/shapefiles_bayern/bayern-260728.osm.pbf"

    // 13.10-13.32 E, 49.05-49.18 N: Bodenmais, the Grosser Arber and the ridge the border follows.
    // Given in lon/lat, but note this is EPSG:25832 data at 13 E -- Bavaria uses zone 32 for the whole
    // state, 1.3 degrees past its nominal 12 E edge, where grid north and true north differ by ~3.2
    // degrees. The lon/lat box is therefore a visibly rotated quadrilateral on the 1 km lattice, which
    // is what transform_bounds(densify_pts=21) in plan_grids.py is there for. Everything downstream
    // stays in EPSG:25832 until k2t tiles it, so the rotation costs nothing.
    region_bbox = '13.104606133632375,49.052154510644336,13.317145624028138,49.18400975069573'
    region_bbox_crs = 'lonlat'

    // 5, not the 2-3 in README.md's laptop column: these are dense forest tiles averaging 296 MB
    // against Bavaria's 208 MB, so the download is what hurts here, not the disk. 5 pulls 122 GiB
    // (1.84x) where 3 pulls 163 GiB (2.45x), for a peak of 15.8 GiB of laz per grid instead of
    // 10.5 GiB. With maxForks 1 that peak is the whole disk requirement.
    grid_size = 5

    // 2 workers x ~2 GB plus headroom is what ~7 GB of free RAM allows. Raise it (and it alone --
    // conf/base.config derives cpus and memory from it) on a machine with more.
    pullauta_processes = 2

    // z13 rather than the z11 default: MAKE_TILES holds every source PNG overlapping one base-zoom
    // tile in memory at once, ~1.1 GB at z12 and a quarter of that at z13. z18 matches the source's
    // 0.42 m/px, and over 230 km2 the deep levels are only ~1 GB of output.
    base_zoom = 13
    max_zoom = 18

    // --limit-rate is per stream, so this is a 4x20M ceiling and not the binding one: geodaten.bayern.de
    // measured ~30 MB/s in aggregate however many streams it was asked for. It is here to keep the run
    // from monopolising a shared uplink for the ~1.2 h the transfer takes.
    download_jobs = 4
    download_limit_rate = '20M'

    map_title = 'mapant -- Bodenmais / Grosser Arber'
    outdir = 'results_bodenmais'
    publish_mode = 'copy'
}

process {
    withLabel: process_pullauta {
        // One grid at a time: 2 concurrent renders would need ~12 GB of RAM on a machine with ~7 GB
        // free. The cost is that a grid's download never overlaps the previous grid's render, which is
        // most of the difference between the ~5 h estimate and the ~4 h of pure compute.
        maxForks = 1
    }
    withLabel: process_tiles {
        maxForks = 2
        memory = 3.GB
    }
    withLabel: process_osm_extract {
        // One osmium pass over the 809 MB Bavaria pbf; the whole region is a single chunk.
        memory = 4.GB
    }
}

/*
 * nextflow.config derives outputDir and the three report paths from params.outdir at the point it is
 * parsed -- which is before this file is merged, so they would all still say 'results'. A profile
 * inside nextflow.config is merged in time and does not need this; a `-c` file does. Overriding here
 * is the same fix for the same trap.
 */
outputDir = params.outdir

timeline.file = "${params.outdir}/pipeline_info/timeline.html"
report.file = "${params.outdir}/pipeline_info/report.html"
trace.file = "${params.outdir}/pipeline_info/trace.txt"
